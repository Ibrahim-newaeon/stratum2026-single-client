# =============================================================================
# Stratum AI - Client Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` next to docker-compose.client.yml and fill in the
# values (deploy/install.sh does this for you automatically — see INSTALL.md).
#
# Every variable below is consumed by deploy/docker-compose.client.yml.
# Required values (no default in the compose file) will make `docker compose`
# fail fast with "variable is not set" until you provide them.
# =============================================================================

# -----------------------------------------------------------------------------
# Registry & version (vendor-provided — do not change unless instructed)
# -----------------------------------------------------------------------------
# Private registry the prebuilt stratum-backend / stratum-frontend images
# live in, e.g. registry.example.com/stratum or ghcr.io/your-org.
STRATUM_REGISTRY=
# Image tag to deploy. "latest" tracks the newest vendor release.
STRATUM_VERSION=latest

# -----------------------------------------------------------------------------
# Domain (required)
# -----------------------------------------------------------------------------
# The single domain this client is deployed on. Caddy requests a Let's
# Encrypt certificate for this domain automatically — it must already have a
# DNS A record pointing at this server, and ports 80/443 must be reachable
# from the internet before starting the stack.
STRATUM_DOMAIN=app.yourclient.com

# Public URL of the app (used in emails, redirects, and CORS). Same-origin
# behind Caddy, so this is always https://<STRATUM_DOMAIN>.
FRONTEND_URL=https://app.yourclient.com

# Comma-separated list of origins allowed to call the API. Must not include
# localhost/127.0.0.1/wildcard — core/config.py rejects those under
# APP_ENV=production. Normally just the one client domain.
CORS_ORIGINS=https://app.yourclient.com

# Base URL the backend uses to build OAuth callback URLs (Meta/Google/TikTok/
# Snapchat "Connect" flows in Settings -> Integrations). The API is
# same-origin behind Caddy, so this is also https://<STRATUM_DOMAIN>.
OAUTH_REDIRECT_BASE_URL=https://app.yourclient.com

# -----------------------------------------------------------------------------
# Application mode
# -----------------------------------------------------------------------------
APP_ENV=production
DEBUG=false
# Real ad-platform APIs (not mock data). Must stay false in production —
# core/config.py hard-rejects USE_MOCK_AD_DATA=true when APP_ENV=production.
USE_MOCK_AD_DATA=false

# -----------------------------------------------------------------------------
# Secrets (auto-generated by install.sh — do not reuse across clients)
# -----------------------------------------------------------------------------
# Signs sessions/CSRF-adjacent tokens. 32+ random chars.
#   openssl rand -base64 32
SECRET_KEY=
# Signs JWT access/refresh tokens. 32+ random chars.
#   openssl rand -base64 32
JWT_SECRET_KEY=
# AES key used to encrypt PII columns at rest. 32+ random chars.
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Database (Postgres)
# -----------------------------------------------------------------------------
POSTGRES_USER=stratum
# openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=stratum_ai

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# openssl rand -base64 24
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Superadmin (owner) account
# -----------------------------------------------------------------------------
# Created/updated with these values ONLY when SEED_SUPERADMIN=true (see
# below). Log in with these after install, then complete the setup wizard.
SUPERADMIN_EMAIL=owner@yourclient.com
# Must be 16+ characters — enforced by backend/scripts/seed_owner.py.
#   openssl rand -base64 24
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Platform Owner

# One-shot seeding switch — must stay `false` outside of first boot / an
# intentional password reset. install.sh sets this to `true` for the fresh
# install, then flips it back to `false` automatically once the health check
# confirms the owner account was seeded. While `true`, EVERY api boot
# force-overwrites the owner's password_hash from SUPERADMIN_PASSWORD above —
# leaving it on would silently revert any password the client changes
# in-app. To reset a forgotten admin password later: set SUPERADMIN_PASSWORD
# to the new value, set this to `true`, restart the api service ONCE, wait
# for it to become healthy, then set this back to `false`. See INSTALL.md's
# "forgot admin password" section.
SEED_SUPERADMIN=false

# -----------------------------------------------------------------------------
# Email (SMTP) — used for password resets, invites, and reports
# -----------------------------------------------------------------------------
# Example using Resend's SMTP relay (https://resend.com/docs/send-with-smtp):
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your Resend API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM_NAME=Stratum AI
EMAIL_FROM_ADDRESS=noreply@yourclient.com

# -----------------------------------------------------------------------------
# Logging & error tracking (optional)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional Sentry DSN for backend error tracking.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Metrics (optional)
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
# Bearer key required to read /metrics from outside the stack. Auto-generated
# by install.sh (openssl rand -base64 32) — required in production. Without
# it, /metrics is open to anyone who can reach the api service.
METRICS_API_KEY=

# -----------------------------------------------------------------------------
# ML / intelligence engine
# -----------------------------------------------------------------------------
# 'local' (bundled scikit-learn models, baked into the image at build time)
# or 'vertex' (Google Vertex AI — requires GCP credentials, not wired into
# this compose file).
ML_PROVIDER=local
# Runtime auto-train is a multi-GB dev fallback that can block /health.
# Models are already pre-trained into the image; leave this false.
ML_AUTO_TRAIN=false
# 'mock', 'serpapi', or 'dataforseo'. Leave as mock until the client
# configures a real provider key under Settings -> Integrations.
MARKET_INTEL_PROVIDER=mock
SERPAPI_KEY=

# -----------------------------------------------------------------------------
# Uploaded asset storage
# -----------------------------------------------------------------------------
# Relative to /app inside the api/worker containers; persisted via the
# asset_uploads named volume. Leave as-is unless you know why you're
# changing it.
ASSET_UPLOAD_DIR=uploads/assets

# -----------------------------------------------------------------------------
# Ad platform credentials (optional — normally configured by the client
# in-app under Settings -> Integrations after first login, not here)
# -----------------------------------------------------------------------------
# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# TikTok Ads
TIKTOK_APP_ID=
TIKTOK_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Snapchat Ads
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
SNAPCHAT_ACCESS_TOKEN=
SNAPCHAT_AD_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# WhatsApp Business API (optional)
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Required (has no default) even if WhatsApp is unused — the backend uses
# this to verify inbound webhook signatures. install.sh auto-generates it.
#   openssl rand -base64 32
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v24.0
